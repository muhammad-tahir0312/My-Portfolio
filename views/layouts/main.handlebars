<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Muhammad's Portfolio</title>
    <link rel="icon" type="image/icon" href="images/icon2.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <style>
      :root {
        --bg: #0b1430;
        --bg-2: #0e1b3d;
        --panel: #102551;
        --card: #132f63;
        --text: #e9f1ff;
        --muted: #bcd2f5;
        --accent: #1e9bff;
        --accent-2: #7ce7ff;
        --border: rgba(255, 255, 255, 0.1);
        --shadow: 0 18px 45px rgba(0, 0, 0, 0.28);
        --radius: 16px;
        --radius-lg: 22px;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: radial-gradient(circle at 20% 20%, rgba(30, 155, 255, 0.12), transparent 30%),
                    radial-gradient(circle at 80% 0%, rgba(124, 231, 255, 0.12), transparent 32%),
                    linear-gradient(135deg, var(--bg), var(--bg-2));
        color: var(--text);
        font-family: 'Space Grotesk', 'Segoe UI', sans-serif;
        letter-spacing: 0.1px;
        min-height: 100vh;
      }

      a { color: inherit; }

      .nav-shell {
        position: sticky;
        top: 0;
        z-index: 10;
        backdrop-filter: blur(12px);
        background: rgba(11, 20, 48, 0.7);
        border-bottom: 1px solid var(--border);
      }

      .navbar-custom {
        padding: 18px 5vw;
      }

      .navbar-brand {
        color: var(--text) !important;
        font-weight: 800;
        letter-spacing: 0.6px;
      }

      .navbar-nav .nav-link {
        color: var(--muted) !important;
        font-weight: 700;
        letter-spacing: 0.3px;
      }

      .navbar-nav .nav-link.active,
      .navbar-nav .nav-link:hover {
        color: var(--accent) !important;
      }

      .home-btn {
        margin-left: 12px;
        padding: 8px 14px;
        border-radius: 999px;
        border: 1px solid var(--border);
        background: rgba(255, 255, 255, 0.08);
        color: var(--text);
        font-weight: 700;
        font-size: 13px;
        text-decoration: none;
        display: none;
      }

      .home-btn:hover {
        border-color: rgba(124, 231, 255, 0.5);
        color: var(--accent);
      }

      .page-shell {
        max-width: 1380px;
        margin: 0 auto;
        padding: 40px 6vw 90px;
      }

      .pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 12px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid var(--border);
        color: var(--muted);
        font-weight: 700;
        font-size: 13px;
      }

      .pill-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--accent);
      }
    </style>
  </head>
  <body>
    <div class="nav-shell">
    <nav class="navbar navbar-expand-lg navbar-dark w-100 navbar-custom">
      <div class="container-fluid"> 
        <a class="navbar-brand" style="font-size: 22px" href="/">MUHAMMAD TAHIR</a>
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNav"
          aria-controls="navbarNav"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
          <ul class="navbar-nav">
            <li class="nav-item">
              <a class="nav-link" style="font-size: 15px" href="/resume">RESUME</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" style="font-size: 15px" href="/project">PROJECTS</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" style="font-size: 15px" href="/certificate">CERTIFICATIONS</a>
            </li>
          </ul>
          <a id="homeNavBtn" class="home-btn" href="/">Home</a>
        </div>
      </div>
    </nav>
    </div>

    {{{body}}}

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
    <script>
      (function() {
        const btn = document.getElementById('homeNavBtn');
        if (!btn) return;
        if (window.location.pathname !== '/') {
          btn.style.display = 'inline-flex';
        }

        const path = window.location.pathname;
        document.querySelectorAll('.navbar-nav .nav-link').forEach(link => {
          if (link.getAttribute('href') === path) {
            link.classList.add('active');
          }
        });
      })();
    </script>
  </body>
</html>
